{
  "name": "knp-birds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Birds of Kruger National Park, served by a Cloudflare Worker.",
  "scripts": {
    "test": "NODE_OPTIONS='--import ./test/register-raw-client.mjs --experimental-vm-modules' node --test",
    "lint": "eslint . && prettier --check \"**/*.{js,mjs}\"",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "icons": "node scripts/build-icons.mjs",
    "seed": "node scripts/seed.mjs",
    "models:download": "node scripts/prepare-audio-recognizer.mjs",
    "kv:dry-run": "node scripts/publish-kv.mjs --dry-run",
    "kv:publish": "node scripts/publish-kv.mjs",
    "models:dry-run": "node scripts/publish-models.mjs --dry-run",
    "models:publish": "node scripts/publish-models.mjs",
    "media:dry-run": "node scripts/publish-media.mjs --dry-run",
    "media:publish": "node scripts/publish-media.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run --outdir dist",
    "audio": "node scripts/process-recordings.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@litertjs/core": "2.6.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "4.6.7"
  }
}

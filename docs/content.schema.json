{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birds.truter.world/schema/content.schema.json",
  "title": "KNP Birds content document",
  "oneOf": [
    { "$ref": "#/$defs/species" },
    { "$ref": "#/$defs/family" },
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/colours" },
    { "$ref": "#/$defs/credits" },
    { "$ref": "#/$defs/identifySound" },
    { "$ref": "#/$defs/identifyPhoto" },
    { "$ref": "#/$defs/offline" },
    { "$ref": "#/$defs/facts" }
  ],
  "$defs": {
    "creditDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "lines"],
      "properties": {
        "summary": { "type": "string", "pattern": "^Credit: ." },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "href"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "href": { "type": "string", "pattern": "^(https?://|/)" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "description": "A range. min equals max when the source gives one figure.",
      "properties": {
        "min": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "nullableMeasure": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/measure" }]
    },
    "parkRegion": {
      "enum": ["far-north", "north", "central", "south"]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "note", "regions", "species"],
      "properties": {
        "kind": { "const": "facts" },
        "note": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "extent"],
            "properties": {
              "id": { "$ref": "#/$defs/parkRegion" },
              "label": { "type": "string", "minLength": 1 },
              "extent": { "type": "string", "minLength": 1 }
            }
          }
        },
        "species": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "scientificName",
              "en",
              "family",
              "status",
              "lengthCm",
              "wingspanCm",
              "massG",
              "flightless",
              "population",
              "regions"
            ],
            "properties": {
              "slug": { "$ref": "#/$defs/slug" },
              "scientificName": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 },
              "family": { "$ref": "#/$defs/slug" },
              "status": {
                "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/status" }]
              },
              "lengthCm": { "$ref": "#/$defs/nullableMeasure" },
              "wingspanCm": { "$ref": "#/$defs/nullableMeasure" },
              "massG": { "$ref": "#/$defs/nullableMeasure" },
              "flightless": { "type": ["boolean", "null"] },
              "population": {
                "type": "object",
                "additionalProperties": false,
                "required": ["low", "high", "unit"],
                "properties": {
                  "low": { "$ref": "#/$defs/nullableInt" },
                  "high": { "$ref": "#/$defs/nullableInt" },
                  "unit": { "type": ["string", "null"] }
                }
              },
              "regions": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/parkRegion" }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "commonNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "af": { "type": "string", "minLength": 1 }
      }
    },
    "status": {
      "enum": [
        "resident",
        "intra-african-migrant",
        "palearctic-migrant",
        "summer-migrant"
      ]
    },
    "colourValue": {
      "description": "A colour name from vocab/colours, an array of those names, or null when unknown.",
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "textOrNull": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "marks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bill", "eye", "legs", "head", "upperparts", "underparts", "wings", "tail"],
      "properties": {
        "bill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colour", "shape"],
          "properties": {
            "colour": { "$ref": "#/$defs/colourValue" },
            "shape": { "$ref": "#/$defs/textOrNull" }
          }
        },
        "eye": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iris", "ring"],
          "properties": {
            "iris": { "$ref": "#/$defs/colourValue" },
            "ring": { "$ref": "#/$defs/colourValue" }
          }
        },
        "legs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colour"],
          "properties": {
            "colour": { "$ref": "#/$defs/colourValue" }
          }
        },
        "head": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crown", "face", "throat"],
          "properties": {
            "crown": { "$ref": "#/$defs/colourValue" },
            "face": { "$ref": "#/$defs/colourValue" },
            "throat": { "$ref": "#/$defs/colourValue" },
            "pattern": { "$ref": "#/$defs/textOrNull" }
          }
        },
        "upperparts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["back", "rump"],
          "properties": {
            "back": { "$ref": "#/$defs/colourValue" },
            "rump": { "$ref": "#/$defs/colourValue" },
            "pattern": { "$ref": "#/$defs/textOrNull" }
          }
        },
        "underparts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["breast", "belly"],
          "properties": {
            "breast": { "$ref": "#/$defs/colourValue" },
            "belly": { "$ref": "#/$defs/colourValue" },
            "pattern": { "$ref": "#/$defs/textOrNull" }
          }
        },
        "wings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["above", "below"],
          "properties": {
            "above": { "$ref": "#/$defs/colourValue" },
            "below": { "$ref": "#/$defs/colourValue" },
            "pattern": { "$ref": "#/$defs/textOrNull" }
          }
        },
        "tail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colour", "shape"],
          "properties": {
            "colour": { "$ref": "#/$defs/colourValue" },
            "shape": { "$ref": "#/$defs/textOrNull" }
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "sex", "season", "marks"],
      "properties": {
        "age": { "enum": ["chick", "juvenile", "immature", "adult"] },
        "sex": { "enum": ["male", "female", "any"] },
        "season": { "enum": ["breeding", "non-breeding", "any"] },
        "marks": { "$ref": "#/$defs/marks" }
      }
    },
    "view": {
      "enum": [
        "flight-above",
        "flight-below",
        "flight-side",
        "perched-front",
        "perched-back",
        "perched-side",
        "display-front",
        "display-back"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "view", "age", "sex", "season", "source", "author", "license", "aiGenerated"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "view": { "$ref": "#/$defs/view" },
        "age": { "enum": ["chick", "juvenile", "immature", "adult"] },
        "sex": { "enum": ["male", "female", "any", "mixed"] },
        "season": { "enum": ["breeding", "non-breeding", "any"] },
        "source": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "licenceUrl": { "$ref": "#/$defs/textOrNull" },
        "aiGenerated": { "type": "boolean" },
        "alt": { "type": "string" },
        "caption": { "type": "string", "minLength": 1 },
        "fileUrl": { "type": "string", "minLength": 1 },
        "hosted": { "type": "boolean" }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "source", "author", "license"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "licenceUrl": { "$ref": "#/$defs/textOrNull" },
        "aiGenerated": { "type": "boolean" },
        "fileUrl": { "type": "string", "minLength": 1 },
        "hosted": { "type": "boolean" },
        "quality": { "enum": ["A", "B", "C", "D", "E"] },
        "modified": { "type": "string", "minLength": 1 }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sex", "type", "description", "recordings"],
      "properties": {
        "sex": { "enum": ["male", "female", "any"] },
        "type": { "enum": ["song", "call", "alarm", "contact", "duet", "other"] },
        "description": { "type": "string", "minLength": 1 },
        "recordings": {
          "type": "array",
          "items": { "$ref": "#/$defs/recording" }
        }
      }
    },
    "nullableInt": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "unit", "trend", "confidence", "asOf", "notes", "sources"],
      "properties": {
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {
            "low": { "$ref": "#/$defs/nullableInt" },
            "high": { "$ref": "#/$defs/nullableInt" }
          }
        },
        "unit": {
          "anyOf": [
            { "type": "null" },
            {
              "enum": [
                "matureIndividuals",
                "individuals",
                "pairs",
                "breeding pairs",
                "breedingPairs",
                "groups",
                "territories"
              ]
            }
          ]
        },
        "trend": { "enum": ["increasing", "stable", "decreasing", "unknown"] },
        "confidence": {
          "anyOf": [
            { "type": "null" },
            { "enum": ["low", "medium", "high"] }
          ]
        },
        "asOf": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1800, "maximum": 2100 }
          ]
        },
        "notes": { "type": "string" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "publisher", "year"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
              "publisher": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
              "year": {
                "anyOf": [
                  { "type": "null" },
                  { "type": "integer", "minimum": 1800, "maximum": 2100 }
                ]
              }
            }
          }
        },
        "kemp": { "$ref": "#/$defs/kempThreshold" },
        "kempBaseline": { "$ref": "#/$defs/kempBaseline" },
        "tierApplied": { "enum": ["A", "D"] }
      }
    },
    "kempThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paperName", "threshold", "thresholdExponent", "status"],
      "properties": {
        "paperName": { "type": "string", "minLength": 1 },
        "threshold": { "type": "integer", "minimum": 1 },
        "thresholdExponent": { "type": "integer", "minimum": 0, "maximum": 40 },
        "status": { "enum": ["RB", "VB", "NB"] }
      }
    },
    "kempBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "unit", "asOf", "notes"],
      "properties": {
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {
            "low": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 }
          }
        },
        "unit": { "const": "matureIndividuals" },
        "asOf": { "type": "integer", "minimum": 1800, "maximum": 2100 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "slug",
        "scientificName",
        "commonNames",
        "family",
        "summary",
        "sampleData",
        "population",
        "variants",
        "viewNotes",
        "calls",
        "images"
      ],
      "properties": {
        "kind": { "const": "species" },
        "slug": { "$ref": "#/$defs/slug" },
        "scientificName": { "type": "string", "minLength": 1 },
        "commonNames": { "$ref": "#/$defs/commonNames" },
        "family": { "$ref": "#/$defs/slug" },
        "status": { "$ref": "#/$defs/status" },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "description": "At least one measurement. A measurement that has not been published is left out.",
          "anyOf": [
            { "required": ["lengthCm"], "properties": { "lengthCm": true } },
            { "required": ["wingspanCm"], "properties": { "wingspanCm": true } },
            { "required": ["massG"], "properties": { "massG": true } }
          ],
          "properties": {
            "lengthCm": { "$ref": "#/$defs/measure" },
            "wingspanCm": { "$ref": "#/$defs/measure" },
            "massG": { "$ref": "#/$defs/measure" },
            "note": { "type": "string" }
          }
        },
        "flightless": {
          "type": "boolean",
          "description": "true when the species cannot fly. Omitted when not recorded."
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where in the park the species is found. At least one region or a note.",
          "anyOf": [
            { "required": ["regions"], "properties": { "regions": true } },
            { "required": ["note"], "properties": { "note": true } }
          ],
          "properties": {
            "regions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/parkRegion" }
            },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "sampleData": { "type": "boolean" },
        "monthsPresent": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "habitat": { "type": "string", "minLength": 1 },
        "similar": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "note"],
            "properties": {
              "slug": { "$ref": "#/$defs/slug" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        },
        "population": { "$ref": "#/$defs/population" },
        "variants": {
          "type": "array",
          "description": "Empty when field marks have not been published yet.",
          "items": { "$ref": "#/$defs/variant" }
        },
        "viewNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "note"],
            "properties": {
              "view": { "$ref": "#/$defs/view" },
              "age": { "enum": ["chick", "juvenile", "immature", "adult"] },
              "sex": { "enum": ["male", "female", "any"] },
              "season": { "enum": ["breeding", "non-breeding", "any"] },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/call" }
        },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/image" }
        },
        "research": { "$ref": "#/$defs/research" }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "needsReview", "note"],
      "description": "Internal research indicator. It is not a claim that every fact on the page has the same authority.",
      "properties": {
        "confidence": { "enum": ["low", "medium", "high"] },
        "needsReview": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "embeddedSpecies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "scientificName", "names"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "scientificName": { "type": "string", "minLength": 1 },
        "names": { "$ref": "#/$defs/commonNames" }
      }
    },
    "familyPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high", "speciesCounted", "speciesTotal", "complete"],
      "properties": {
        "low": { "$ref": "#/$defs/nullableInt" },
        "high": { "$ref": "#/$defs/nullableInt" },
        "speciesCounted": { "type": "integer", "minimum": 0 },
        "speciesTotal": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    },
    "familyResidency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speciesKnown", "speciesUnknown", "unknownSpecies"],
      "properties": {
        "speciesKnown": { "type": "integer", "minimum": 0 },
        "speciesUnknown": { "type": "integer", "minimum": 0 },
        "unknownSpecies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slug", "scientificName", "commonNames", "summary", "sampleData", "species", "iconicSpecies", "population", "residency"],
      "properties": {
        "kind": { "const": "family" },
        "slug": { "$ref": "#/$defs/slug" },
        "scientificName": { "type": "string", "minLength": 1 },
        "commonNames": { "$ref": "#/$defs/commonNames" },
        "summary": { "type": "string", "minLength": 1 },
        "sampleData": { "type": "boolean" },
        "species": {
          "type": "array",
          "items": { "$ref": "#/$defs/embeddedSpecies" }
        },
        "iconicSpecies": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "population": { "$ref": "#/$defs/familyPopulation" },
        "residency": { "$ref": "#/$defs/familyResidency" }
      }
    },
    "indexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "af", "population"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "af": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "population": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/indexEntry" },
      "propertyNames": { "type": "string", "minLength": 1 }
    },
    "creditsLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "usedFor", "licence", "licenceUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/creditsLink" }
        },
        "usedFor": { "type": "string", "minLength": 1 },
        "licence": { "$ref": "#/$defs/textOrNull" },
        "licenceUrl": { "$ref": "#/$defs/textOrNull" }
      }
    },
    "mediaCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "author", "licence", "licenceUrl", "sourceUrl", "aiGenerated"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/$defs/textOrNull" },
        "licence": { "$ref": "#/$defs/textOrNull" },
        "licenceUrl": { "$ref": "#/$defs/textOrNull" },
        "sourceUrl": { "$ref": "#/$defs/textOrNull" },
        "aiGenerated": { "type": "boolean" },
        "hosted": { "type": "boolean" },
        "callType": { "type": "string", "minLength": 1 },
        "quality": { "enum": ["A", "B", "C", "D", "E"] },
        "modified": { "type": "string", "minLength": 1 }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "publisher", "year"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/textOrNull" },
        "publisher": { "$ref": "#/$defs/textOrNull" },
        "year": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1800, "maximum": 2100 }
          ]
        }
      }
    },
    "speciesCredits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "scientificName", "commonName", "images", "recordings", "sources"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "scientificName": { "type": "string", "minLength": 1 },
        "commonName": { "type": "string", "minLength": 1 },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/mediaCredit" }
        },
        "recordings": {
          "type": "array",
          "items": { "$ref": "#/$defs/mediaCredit" }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        }
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dataSources", "taxonomy", "mediaNote", "species", "models", "site"],
      "properties": {
        "kind": { "const": "credits" },
        "dataSources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dataSource" }
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "summary"],
          "properties": {
            "authority": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "mediaNote": { "$ref": "#/$defs/textOrNull" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelCredit" }
        },
        "species": {
          "type": "array",
          "items": { "$ref": "#/$defs/speciesCredits" }
        },
        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "licence", "licenceUrl", "maintainer", "palette", "affiliation", "media"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "licence": { "type": "string", "minLength": 1 },
            "licenceUrl": { "type": "string", "minLength": 1 },
            "maintainer": { "type": "string", "minLength": 1 },
            "palette": { "type": "string", "minLength": 1 },
            "affiliation": { "type": "string", "minLength": 1 },
            "media": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "modelCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "authors",
        "publisher",
        "citation",
        "url",
        "licence",
        "licenceUrl",
        "usedFor",
        "runtime"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "licenceUrl": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "usedFor": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href", "label"],
          "properties": {
            "href": { "type": "string", "pattern": "^/" },
            "label": { "type": "string", "minLength": 1 }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "note"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "published": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "note"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url",
            "licence",
            "licenceUrl"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "licence": {
              "type": "string",
              "minLength": 1
            },
            "licenceUrl": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "identifyPhoto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model", "counts", "evaluation", "families", "covered", "notInModel"],
      "properties": {
        "kind": { "const": "identify-photo" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "baseModel", "inputSize", "classCount", "bytes", "sha256", "trainingPhotos", "trainingLicences"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "baseModel": { "type": "string", "minLength": 1 },
            "inputSize": { "type": "integer", "minimum": 1 },
            "classCount": { "type": "integer", "minimum": 1 },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "trainingPhotos": { "type": "integer", "minimum": 0 },
            "trainingLicences": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "licence": { "type": "string", "minLength": 1 },
            "licenceUrl": { "type": ["string", "null"], "minLength": 1 },
            "huggingFace": { "type": "string", "pattern": "^https://huggingface\\.co/" }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["species", "covered", "notInModel"],
          "properties": {
            "species": { "type": "integer", "minimum": 0 },
            "covered": { "type": "integer", "minimum": 0 },
            "notInModel": { "type": "integer", "minimum": 0 }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["photos", "species", "top1", "top3", "top5", "family", "top3MeanOverSpecies", "speciesScore", "familyScore", "familyWhenSpeciesUnsure", "neitherConfident"],
          "properties": {
            "photos": { "type": "integer", "minimum": 0 },
            "species": { "type": "integer", "minimum": 0 },
            "top1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "top3": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "top5": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "family": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "top3MeanOverSpecies": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "speciesScore": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["atLeast", "photos", "correct"],
              "properties": {
                "atLeast": { "type": "number" },
                "photos": { "type": "integer", "minimum": 0 },
                "correct": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
              }
            }
          },
            "familyScore": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["atLeast", "photos", "correct"],
              "properties": {
                "atLeast": { "type": "number" },
                "photos": { "type": "integer", "minimum": 0 },
                "correct": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
              }
            }
          },
            "familyWhenSpeciesUnsure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["photos", "correct"],
              "properties": { "photos": { "type": "integer", "minimum": 0 }, "correct": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } }
            },
            "neitherConfident": { "type": "integer", "minimum": 0 }
          }
        },
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scientificName", "en", "evaluation"],
            "properties": {
              "scientificName": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 },
              "evaluation": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["photos", "top1", "top3", "family"],
                "properties": { "photos": { "type": "integer", "minimum": 0 }, "top1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "top3": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "family": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } }
              }
            }
          }
        },
        "covered": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "scientificName", "en", "af", "family", "label", "monthsPresent", "image", "trainingPhotos", "evaluationPhotos"],
            "properties": {
              "slug": { "$ref": "#/$defs/slug" },
              "scientificName": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 },
              "af": { "$ref": "#/$defs/textOrNull" },
              "family": { "$ref": "#/$defs/slug" },
              "label": { "type": "integer", "minimum": 0 },
              "monthsPresent": {
                "type": ["array", "null"],
                "items": { "type": "integer", "minimum": 1, "maximum": 12 }
              },
              "image": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["src", "alt", "caption", "credit"],
                "properties": {
                  "src": { "type": "string", "minLength": 1 },
                  "alt": { "type": "string" },
                  "caption": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text"],
                    "properties": {
                      "label": { "const": "AI-generated image" },
                      "text": { "type": "string" }
                    }
                  },
                  "credit": { "$ref": "#/$defs/creditDisclosure" }
                }
              },
              "trainingPhotos": { "type": "integer", "minimum": 0 },
              "evaluationPhotos": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "notInModel": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "scientificName", "en", "af"],
            "properties": {
              "slug": { "$ref": "#/$defs/slug" },
              "scientificName": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 },
              "af": { "$ref": "#/$defs/textOrNull" }
            }
          }
        }
      }
    },
    "identifySound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "model",
        "counts",
        "families",
        "covered",
        "broaderLabelOnly",
        "notInModel"
      ],
      "properties": {
        "kind": {
          "const": "identify-sound"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "labelCount",
            "labelsSha256",
            "sampleRate",
            "windowSeconds"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "labelCount": {
              "type": "integer",
              "minimum": 1
            },
            "labelsSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sampleRate": {
              "type": "integer"
            },
            "windowSeconds": {
              "type": "integer"
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "species",
            "covered",
            "broaderLabelOnly",
            "notInModel"
          ],
          "properties": {
            "species": {
              "type": "integer",
              "minimum": 0
            },
            "covered": {
              "type": "integer",
              "minimum": 0
            },
            "broaderLabelOnly": {
              "type": "integer",
              "minimum": 0
            },
            "notInModel": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scientificName",
              "en"
            ],
            "properties": {
              "scientificName": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "covered": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "scientificName",
              "en",
              "af",
              "family",
              "labels",
              "modelNames",
              "monthsPresent",
              "image",
              "call"
            ],
            "properties": {
              "slug": {
                "$ref": "#/$defs/slug"
              },
              "scientificName": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "af": {
                "$ref": "#/$defs/textOrNull"
              },
              "family": {
                "$ref": "#/$defs/slug"
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "modelNames": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "monthsPresent": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    }
                  }
                ]
              },
              "image": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "src",
                      "credit"
                    ],
                    "properties": {
                      "src": {
                        "type": "string",
                        "minLength": 1
                      },
                      "aiGenerated": {
                        "const": true
                      },
                      "credit": {
                        "$ref": "#/$defs/creditDisclosure"
                      },
                      "alt": {
                        "type": "string",
                        "minLength": 1
                      },
                      "caption": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["text"],
                        "properties": {
                          "label": { "const": "AI-generated image" },
                          "text": { "type": "string" }
                        }
                      },
                      "type": {
                        "$ref": "#/$defs/textOrNull"
                      }
                    }
                  }
                ]
              },
              "call": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "src",
                      "credit"
                    ],
                    "properties": {
                      "src": {
                        "type": "string",
                        "minLength": 1
                      },
                      "aiGenerated": {
                        "const": true
                      },
                      "credit": {
                        "$ref": "#/$defs/creditDisclosure"
                      },
                      "alt": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "$ref": "#/$defs/textOrNull"
                      }
                    }
                  }
                ]
              },
              "partial": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "broaderLabelOnly": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "scientificName",
              "en",
              "af",
              "modelLabel",
              "reason"
            ],
            "properties": {
              "slug": {
                "$ref": "#/$defs/slug"
              },
              "scientificName": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "af": {
                "$ref": "#/$defs/textOrNull"
              },
              "modelLabel": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notInModel": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "scientificName",
              "en",
              "af"
            ],
            "properties": {
              "slug": {
                "$ref": "#/$defs/slug"
              },
              "scientificName": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "af": {
                "$ref": "#/$defs/textOrNull"
              }
            }
          }
        }
      }
    },
    "offlineMedia": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "url", "bytes", "alias"],
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "url": { "type": "string", "pattern": "^/(images|audio)/offline/" },
          "bytes": { "type": "integer", "minimum": 1 },
          "alias": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pages", "iconic", "images", "clips"],
      "properties": {
        "kind": { "const": "offline" },
        "pages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } },
        "iconic": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "images": { "$ref": "#/$defs/offlineMedia" },
        "clips": { "$ref": "#/$defs/offlineMedia" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "slug", "sampleData", "summary", "colours"],
      "properties": {
        "kind": { "const": "vocab" },
        "name": { "const": "colours" },
        "slug": { "const": "colours" },
        "sampleData": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "colours": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hex", "ridgway", "smithe"],
            "properties": {
              "name": { "$ref": "#/$defs/slug" },
              "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "ridgway": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
              "smithe": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
            }
          }
        }
      }
    }
  }
}
